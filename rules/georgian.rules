# georgian.rules — Standard Georgian (strand 4). Task 23a: [meta] [inventory] [classes]
# [substitute] [stress] [epithets] [post-stress] [respell]; Task 23b: [syllable] whitelists,
# bans and [repair]. Every rule line cites its digest
# section (sources/georgian/digest.md) or the decision-register row (spec §9) it implements.

[meta]
name = Georgian
digest = sources/georgian/digest.md
# I-39 / spec §12.H: the abstract epithet slots of DESC+ADJ / DESC+NOUN.
epithet-ADJ = URI
epithet-NOUN = NOM_I

[inventory]
# digest §1.1 chart [shosted2006 p.255]: 28 consonants, three-way laryngeal series
# (voiced / voiceless aspirated / ejective). The chart writes the aspirated affricates bare
# (`ts tʃ`); `tʃʰ` is the Task 1b hand row the spec (§7) and the slender-coronal rules use,
# and `ts` keeps the chart's spelling (features.tsv has no `tsʰ` row).
pʰ pʼ b tʰ tʼ d kʰ kʼ ɡ qʼ
ts tsʼ dz tʃʰ tʃʼ dʒ
m n v s z ʃ ʒ x ɣ h l
# digest §1.7 [shosted2006 p.261]: one rhotic, tap ~ trill in free variation (PHOIBLE `[ɾ r]`,
# §1.9). The attested rows and the romanization both write it `r`, so `r` is the canonical
# symbol here; the phonetic default is the tap.
r
# digest §1.8 [shosted2006 p.261-262]: five short vowels, no length, no diphthongs (§4.4).
i ɛ ɑ ɔ u
# /f/ absent (§1.4); /ŋ w j/ absent (§3.2); /x ɣ/ velar with PHOIBLE and shosted2006 (§1.2).

[classes]
# I-41 / spec §12.J: the Irish source-side series, copied verbatim into every target file.
BROAD = pˠ bˠ t̪ˠ d̪ˠ fˠ sˠ w vˠ mˠ n̪ˠ l̪ˠ ɾˠ k ɡ x ɣ ŋ
SLEN  = pʲ bʲ tʲ dʲ fʲ ʃ vʲ mʲ nʲ lʲ ɾʲ c ɟ ç j ɲ

[substitute]
# Order matters (each rule sees the previous rule's output):
#   1. vowels — so that Irish /a aː ə/ (front=- back=- in PHOIBLE) are Georgian /ɑ/ (back=+)
#      before the Ci rule asks for `[V +back]`;
#   2. the Cʷ / Ci epentheses over the still-Irish BROAD / SLEN consonants;
#   3. the broad/slender collapse and the segment substitutions;
#   4. the post-consonantal ejective, then the aspirate default (spec §9 row 4);
#   5. degemination of the sequences the epentheses can create.

# 1. Vowels. digest §3.4 [gabunia2021 p.13] "vowel length is not significant"; §4.4
#    [shosted2006 p.262]; §8.3 /ɑː iː uː oː eː/ -> /ɑ i u ɔ ɛ/.
iː -> i          %attested # digest §8.3 [gabunia2021 p.13; shosted2006 p.262]
uː -> u          %attested # digest §8.3
eː -> ɛ          %attested # digest §8.3
oː -> ɔ          %attested # digest §8.3
aː -> ɑ          %attested # digest §8.3
ɪ  -> i          %attested # digest §3.4 [gabunia2021 p.13] "corresponding short vowels"
ʊ  -> u          %attested # digest §3.4
a  -> ɑ          %attested # digest §1.8 [shosted2006 p.261-262] the open vowel is /ɑ/
e  -> ɛ          %attested # digest §1.8
o  -> ɔ          %attested # digest §1.8
# Georgian has no schwa (§8.2 [crouch2022-diss §1.3 p.39]); spec §7 fixes ə -> a. The digest
# leaves /ɑ/ vs /ɛ/ open and §8.3 would prefer /əi əu/ -> /ɛi ɔu/; the spec's default wins (I-28).
ə  -> ɑ          %design   # design: §7 (ə -> a) · digest §8.2 line 1470 open

# 2. Secondary articulation (digest §8.1 Option C, an OPEN DECISION at lines 1440-1442).
#    Cʷ: broad non-labial C -> C v before a front vowel. The class term is BROAD, never
#    `[C +back]` (spec §12.J: that would exclude plain /k ɡ x ɣ ŋ/). The "before /i ɛ/, onsets
#    only" restriction is ours — §8.1 Option C is unconditional. Labials excluded because /v/
#    after a labial is not a Georgian cluster shape (§1.6: /v/ fills the sonorant slot of
#    obstruent clusters).
0 -> v / [BROAD -labial] _ [V +front]     %design # design: goals decision 5 (2026-08-25); digest §8.1 lines 1440-1442 open
#    /j/ -> /i/ before the Ci rule so a lenited slender d/g does not become /ii/.
j -> i                                    %attested # digest §3.2 [gabunia2021 p.14] yoghurt -> iogurti
#    Ci: slender C -> C i before a back vowel (spec §9 row 2). SLEN, not `[C +front]`.
0 -> i / [SLEN] _ [V +back]               %design # design: §9.2 · digest §8.1 Option B/C lines 1440-1442 open

# 3a. Slender coronals -> the postalveolar series. Nothing in the digest decides this:
#     §8.1 lines 1440-1442 "PROJECT OVERLAYS / an OPEN DECISION"; §8.2 line 1470 offers
#     /tʰ tʼ d/ or /tʃʰ tʃʼ dʒ/ "(unattested for Georgian)". Spec §7 / §9 row 1 picks the
#     affricates; /ʃ/ is native (ჩ ʃ) and stays.
tʲ -> tʃʰ        %design   # design: §9.1 · digest §8.1 lines 1440-1442 open; §8.2 line 1470
dʲ -> dʒ         %design   # design: §9.1 · digest §8.1 lines 1440-1442 open; §8.2 line 1470
# 3b. Broad/slender collapse to the plain segment (spec §9 row 1: dropped on labials and
#     dorsals; the coronal contrast is carried by 3a and the Ci rule). digest §8.2 table.
pˠ -> p          %design   # design: §9.1 · digest §8.2 line 1466 (/p/ is an OPEN DECISION)
pʲ -> p          %design   # design: §9.1
bˠ -> b          %design   # design: §9.1
bʲ -> b          %design   # design: §9.1
t̪ˠ -> t          %design   # design: §9.1
d̪ˠ -> d          %design   # design: §9.1
c  -> k          %design   # design: §9.1
ɟ  -> ɡ          %design   # design: §9.1
sˠ -> s          %attested # digest §3.2 [gabunia2021 p.14] /s/ unchanged
mˠ -> m          %attested # digest §8.2 one /m/
mʲ -> m          %attested # digest §8.2
n̪ˠ -> n          %attested # digest §8.2 one /n/
nʲ -> n          %attested # digest §8.2
ŋ  -> n          %design   # design: §7 (ŋ -> n) · contra digest §3.2 line 879, which gives /nɡ/
ɲ  -> n          %attested # digest §8.2 one /n/
l̪ˠ -> l          %attested # digest §8.2 one /l/ [wiki-help-ipa-ka n.4]
lʲ -> l          %attested # digest §8.2
ɾˠ -> r          %attested # digest §8.2 one rhotic [shosted2006 p.261]
ɾʲ -> r          %attested # digest §8.2
ç  -> x          %design   # design: §9.1 · digest §8.2 /x/ native; no palatal fricative
# 3c. Segment substitutions.
fˠ -> pʰ         %attested # digest §3.2 [gabunia2021 p.15] Facebook -> /pʰɛisbukʼi/; §8.2
fʲ -> pʰ         %attested # digest §3.2 [gabunia2021 p.15]
f  -> pʰ         %attested # digest §3.2 [gabunia2021 p.15]
# /w/ -> /v/ is spec §9 row 6. WARNING carried from digest §3.3 (a CONFLICT): the digest's own
# (unattested, overlay) recommendation is POSITIONAL — /w/ -> /u/ word-initially, /v/ medially
# [rayfield2023 pp.23-24] — and Irish /w/ arrives word-initially from lenited b/m, exactly
# where that rule would give /u/ (a hiatus vowel) instead.
w  -> v          %design   # design: §9.6 · digest §3.3 lines 889-920 CONFLICT (positional /u/ ~ /v/)
vˠ -> v          %attested # digest §8.2 /v/ native [shosted2006 p.261]
vʲ -> v          %attested # digest §8.2

# 4. The /p t k/ OPEN DECISION (digest §3.1). Spec §9 row 4: aspirate by default, ejective
#    after a consonant. Digest §3.1 line 818 says of exactly this split "That is not what the
#    source supports", and lines 862-868 recommend the ejective as the UNCONDITIONAL default
#    ("Do not encode the 84.1%/26.5% split as a categorical environment rule"). Spec §9 fixes
#    our default; the digest is evidence, not authority (I-29). Written as explicit segment
#    lines: `[STOP -voice] -> [+ejective]` is UNREACHABLE_CHANGE, because PHOIBLE's `pʼ` row
#    differs from `p` in more than raisedLarynxEjective (I-4 exact lookup).
p -> pʼ / C _    %design # design: §9.4 · contra digest §3.1 line 818; lines 862-868
t -> tʼ / C _    %design # design: §9.4 · contra digest §3.1 line 818; lines 862-868
k -> kʼ / C _    %design # design: §9.4 · contra digest §3.1 line 818; lines 862-868
tʃʰ -> tʃʼ / C _ %design # design: §9.4 applied to the affricate of 3a · digest §8.2 line 1470
p -> pʰ          %design   # design: §9.4 · digest §3.1 line 821 Eng-like /pʰ tʰ kʰ/ [gabunia2021 p.16]
t -> tʰ          %design   # design: §9.4 · digest §3.1 line 821
k -> kʰ          %design   # design: §9.4 · digest §3.1 line 821

# 5. Degemination of what the epentheses and /w/ -> /v/ can create (repeated segments, I-2):
#    the /v/ of a broad consonant next to the /v/ from lenited b/m (§8.1 note, line 1447:
#    "would merge"; slot-V /v/ is at most one per cluster [butskhrikidze2002 p.108]).
v v -> v         %design   # design: goals decision 5 (2026-08-25) · digest §8.1 line 1447; §3.6
i i -> i         %design   # design: §9.2 (Ci rule) · digest §3.6 degemination is exceptionless

[syllable]
# Task 23b. digest §2.1 [butskhrikidze2002 p.41, p.100]: "the syllable … cannot serve as the
# domain of phonotactic generalisations" — no syllable template; the stem is the domain and
# the stem-edge inventories (§2.3 Appendix 2, §2.5 Appendix 3) are the whitelists (I-27).
template = any
domain   = stem
# digest §2.7 [crouch2022-diss §1.3.1 p.13] "the SSP is not relevant for syllabification in
# Georgian"; rises, plateaus and falls are all attested word-initially (I-13).
sonority = off
# experiment 2026-08-25: pairwise legality; owner to confirm
# digest §2.1, §2.13 [butskhrikidze2002]: underlying clusters are maximally biconsonantal and
# the long surface clusters of the whitelists arise by syncope, so a candidate cluster is
# licensed by its adjacent PAIRS (drawn from `onsets` / `codas` below) rather than as a whole
# listed string; singletons are still legal only if listed.
cluster-legality = pairwise
# No `nuclei` (spec §12.B, I-2): digest §2.9 [shosted2006 p.262] — no diphthongs; adjacent
# vowels are heterosyllabic ([ɡirɑɔ] 'mortgage'), and "loanwords are exactly where Georgian
# tolerates VV" (§2.9 [butskhrikidze2002 p.83 n.8]). §2.9's monomorphemic VV bar is therefore
# NOT written as a ban: the attested loans (§7: *uaildi, jeimz, brius*) all carry hiatus.
#
# onsets — the COMPLETE stem-initial set (spec §12.D), transcribed by
# rules/extract_georgian_clusters.py from the digest's prose (R29; her notation -> IPA per
# §2.0, and `c` -> the chart's `ts`). Singletons first: §2.8 [butskhrikidze2002 p.99] "All 33
# phonemes of Georgian can appear in word-initial position" (/h/ included, though receding).
# Tiers (onsets-tier):
#   HARMONIC — §2.2 table (53) [butskhrikidze2002 p.103], 30 of the 32: `zg` and `žg` are
#              EXCLUDED — "almost unattested" [p.103 n.20], `zg` marked impossible in table
#              (62) [p.110] (S8). Only 24 of the 32 are given in IPA at §2.2; the fricative-
#              initial 6 (`sk šk zγ žγ sx šx`) are read through the §2.0 chart.
#   APP2     — §2.3 Appendix 2 [butskhrikidze2002 pp.197–205]: CC by manner class, CCC a)–z),
#              CCCC, the CCCCC `c'vrtn` and the CCCCCC `prckvn brdγvn`. "Not exhaustive",
#              excludes /m/+C and all but two /v/+C [p.197].
#   INIT     — §2.5 [butskhrikidze2002 p.207] the set "attested stem-initially but not
#              stem-finally": t'b k'b xb tb gd xd gǰ.
#   GRID     — §2.6 table (62) [butskhrikidze2002 p.110], the attested initial CC grid.
#   LOAN     — §3.7 [gabunia2021 pp.50–51]: clusters the digest lists as kept unrepaired in
#              attested loans and calls "licensed by §2 independently" but which the §2 lists
#              (being non-exhaustive) do not print: `sn` (*snack* -> /snɛkʼi/; §3.7 and §8.4
#              flag the gap as "an artefact of the list being non-exhaustive rather than a
#              ban").
onsets   = pʰ pʼ b tʰ tʼ d kʰ kʼ ɡ qʼ ts tsʼ dz tʃʰ tʃʼ dʒ m n v s z ʃ ʒ x ɣ h l r bɡ pʰkʰ pʼkʼ bɣ pʰx pʼqʼ dɡ tʰkʰ tʼkʼ dɣ tʰx tʼqʼ dzɡ tskʰ tsʼkʼ dzɣ tsx tsʼqʼ dʒɡ tʃʰkʰ tʃʼkʼ dʒɣ tʃʰx tʃʼqʼ skʰ zɣ sx ʃkʰ ʒɣ ʃx ɡd kʼb tʰb brdʒ btʃʼ brdz kʰts bz bʒ ɡz kʰs kʰʃ pʰʃ bl bm bn br dv dm dn dr ɡv ɡl ɡm ɡn ɡr kʰv kʰl kʰm kʰn kʰr kʼv kʼl kʼm kʼn kʼr pʰl pʰr pʼl pʼr tʰv tʰl tʰm tʰr tʼv tʼl tʼr tsd tʃʼd dʒd tsv tsm tsn tsr tʃʰv tʃʰl tʃʰr tsʼv tsʼl tsʼm tsʼn tsʼr tʃʼv tʃʼl tʃʼm tʃʼr dzv dzl dzm dzn dzr dʒv dʒm skʼ stʼ ʃpʰ ʃtʰ ʃtʼ xd qʼb qʼd stsʼ xts xʃ sv sl sm sr ʃv ʃl ʃm ʃn ʃr zv zl zm zn zr ʒr ʒl ɣv ɣl ɣm ɣr xv xl xm xn xr qʼv qʼl qʼm qʼn qʼr lb ltʼ nd rb rɡ rkʰ rkʼ rtʼ rtsʼ rdz rdʒ vs lx rqʼ lm tʼkʼb tʰkʰv tʰkʰr pʼtsʼkʼ pʰskʼ bɣv tʰxl tʰxr tʼqʼv tʼqʼl brb brɡ brkʰ ɡrd kʰrtʰ kʼvd kʼld kʼrtʰ pʰrtʰ tʰrtʰ zrd ɡrdz kʼrdz brm ɡvr kʼvn kʼvr tʰvl tskʰv tsʼkʼl tsʼkʼm tsʼkʼr tʃʼkʼn tsxv tsxr tʃʰxr tsʼqʼv tsʼqʼl tsʼqʼr tsʼqʼn tʃʼqʼl dzɣv tsʼrtʰ tsʼrpʰ dzrtsʼ tʃʰrd tsʼvr tʃʼvr dzvr stʼv stsʼr sxv zɣv xsn xrtʼ qʼrd ɣrdz ʒrʒ ʃvr zmn ɣrm xvr rɡv rtʰv ndʒr rtsx rtsʼqʼ rɣv vrts tʰkʰvl tʰxzv pʰxvn pʰʃvn brtʼqʼ pʰrtʰx ɡrɡv pʰrkʰv brtsʼqʼ brtʃʼqʼ pʰrtʃʰx ɡrdzn tsʼqʼvd tʃʰxvl tsʼrtʰv sxvl xrtsʼn ɣrɣn rtʼqʼm ndʒɣr rtsxv rqʼvn tsʼvrtʰn pʰrtskʰvn brdɣvn tʼb xb ɡdʒ bdʒ pʰtʰ pʰtʃʰ pʰs pʰn pʼn dl tsb tstʰ tsʼb tsʼtʰ dʒl tʃʰm tʃʼn spʰ spʼ ʒv ʃpʼ ɣd ɣdz ɣdʒ ɣn xs lpʼ lqʼ lv rtʰ rts rtʃʰ rɣ rx rv ntʰ nɡ ndʒ sn
onsets-tier = bɡ:HARMONIC pʰkʰ:HARMONIC pʼkʼ:HARMONIC bɣ:HARMONIC pʰx:HARMONIC pʼqʼ:HARMONIC dɡ:HARMONIC tʰkʰ:HARMONIC tʼkʼ:HARMONIC dɣ:HARMONIC tʰx:HARMONIC tʼqʼ:HARMONIC dzɡ:HARMONIC tskʰ:HARMONIC tsʼkʼ:HARMONIC dzɣ:HARMONIC tsx:HARMONIC tsʼqʼ:HARMONIC dʒɡ:HARMONIC tʃʰkʰ:HARMONIC tʃʼkʼ:HARMONIC dʒɣ:HARMONIC tʃʰx:HARMONIC tʃʼqʼ:HARMONIC skʰ:HARMONIC zɣ:HARMONIC sx:HARMONIC ʃkʰ:HARMONIC ʒɣ:HARMONIC ʃx:HARMONIC ɡd:APP2 kʼb:APP2 tʰb:APP2 brdʒ:APP2 btʃʼ:APP2 brdz:APP2 kʰts:APP2 bz:APP2 bʒ:APP2 ɡz:APP2 kʰs:APP2 kʰʃ:APP2 pʰʃ:APP2 bl:APP2 bm:APP2 bn:APP2 br:APP2 dv:APP2 dm:APP2 dn:APP2 dr:APP2 ɡv:APP2 ɡl:APP2 ɡm:APP2 ɡn:APP2 ɡr:APP2 kʰv:APP2 kʰl:APP2 kʰm:APP2 kʰn:APP2 kʰr:APP2 kʼv:APP2 kʼl:APP2 kʼm:APP2 kʼn:APP2 kʼr:APP2 pʰl:APP2 pʰr:APP2 pʼl:APP2 pʼr:APP2 tʰv:APP2 tʰl:APP2 tʰm:APP2 tʰr:APP2 tʼv:APP2 tʼl:APP2 tʼr:APP2 tsd:APP2 tʃʼd:APP2 dʒd:APP2 tsv:APP2 tsm:APP2 tsn:APP2 tsr:APP2 tʃʰv:APP2 tʃʰl:APP2 tʃʰr:APP2 tsʼv:APP2 tsʼl:APP2 tsʼm:APP2 tsʼn:APP2 tsʼr:APP2 tʃʼv:APP2 tʃʼl:APP2 tʃʼm:APP2 tʃʼr:APP2 dzv:APP2 dzl:APP2 dzm:APP2 dzn:APP2 dzr:APP2 dʒv:APP2 dʒm:APP2 skʼ:APP2 stʼ:APP2 ʃpʰ:APP2 ʃtʰ:APP2 ʃtʼ:APP2 xd:APP2 qʼb:APP2 qʼd:APP2 stsʼ:APP2 xts:APP2 xʃ:APP2 sv:APP2 sl:APP2 sm:APP2 sr:APP2 ʃv:APP2 ʃl:APP2 ʃm:APP2 ʃn:APP2 ʃr:APP2 zv:APP2 zl:APP2 zm:APP2 zn:APP2 zr:APP2 ʒr:APP2 ʒl:APP2 ɣv:APP2 ɣl:APP2 ɣm:APP2 ɣr:APP2 xv:APP2 xl:APP2 xm:APP2 xn:APP2 xr:APP2 qʼv:APP2 qʼl:APP2 qʼm:APP2 qʼn:APP2 qʼr:APP2 lb:APP2 ltʼ:APP2 nd:APP2 rb:APP2 rɡ:APP2 rkʰ:APP2 rkʼ:APP2 rtʼ:APP2 rtsʼ:APP2 rdz:APP2 rdʒ:APP2 vs:APP2 lx:APP2 rqʼ:APP2 lm:APP2 tʼkʼb:APP2 tʰkʰv:APP2 tʰkʰr:APP2 pʼtsʼkʼ:APP2 pʰskʼ:APP2 bɣv:APP2 tʰxl:APP2 tʰxr:APP2 tʼqʼv:APP2 tʼqʼl:APP2 brb:APP2 brɡ:APP2 brkʰ:APP2 ɡrd:APP2 kʰrtʰ:APP2 kʼvd:APP2 kʼld:APP2 kʼrtʰ:APP2 pʰrtʰ:APP2 tʰrtʰ:APP2 zrd:APP2 ɡrdz:APP2 kʼrdz:APP2 brm:APP2 ɡvr:APP2 kʼvn:APP2 kʼvr:APP2 tʰvl:APP2 tskʰv:APP2 tsʼkʼl:APP2 tsʼkʼm:APP2 tsʼkʼr:APP2 tʃʼkʼn:APP2 tsxv:APP2 tsxr:APP2 tʃʰxr:APP2 tsʼqʼv:APP2 tsʼqʼl:APP2 tsʼqʼr:APP2 tsʼqʼn:APP2 tʃʼqʼl:APP2 dzɣv:APP2 tsʼrtʰ:APP2 tsʼrpʰ:APP2 dzrtsʼ:APP2 tʃʰrd:APP2 tsʼvr:APP2 tʃʼvr:APP2 dzvr:APP2 stʼv:APP2 stsʼr:APP2 sxv:APP2 zɣv:APP2 xsn:APP2 xrtʼ:APP2 qʼrd:APP2 ɣrdz:APP2 ʒrʒ:APP2 ʃvr:APP2 zmn:APP2 ɣrm:APP2 xvr:APP2 rɡv:APP2 rtʰv:APP2 ndʒr:APP2 rtsx:APP2 rtsʼqʼ:APP2 rɣv:APP2 vrts:APP2 tʰkʰvl:APP2 tʰxzv:APP2 pʰxvn:APP2 pʰʃvn:APP2 brtʼqʼ:APP2 pʰrtʰx:APP2 ɡrɡv:APP2 pʰrkʰv:APP2 brtsʼqʼ:APP2 brtʃʼqʼ:APP2 pʰrtʃʰx:APP2 ɡrdzn:APP2 tsʼqʼvd:APP2 tʃʰxvl:APP2 tsʼrtʰv:APP2 sxvl:APP2 xrtsʼn:APP2 ɣrɣn:APP2 rtʼqʼm:APP2 ndʒɣr:APP2 rtsxv:APP2 rqʼvn:APP2 tsʼvrtʰn:APP2 pʰrtskʰvn:APP2 brdɣvn:APP2 tʼb:INIT xb:INIT ɡdʒ:INIT bdʒ:GRID pʰtʰ:GRID pʰtʃʰ:GRID pʰs:GRID pʰn:GRID pʼn:GRID dl:GRID tsb:GRID tstʰ:GRID tsʼb:GRID tsʼtʰ:GRID dʒl:GRID tʃʰm:GRID tʃʼn:GRID spʰ:GRID spʼ:GRID ʒv:GRID ʃpʼ:GRID ɣd:GRID ɣdz:GRID ɣdʒ:GRID ɣn:GRID xs:GRID lpʼ:GRID lqʼ:GRID lv:GRID rtʰ:GRID rts:GRID rtʃʰ:GRID rɣ:GRID rx:GRID rv:GRID ntʰ:GRID nɡ:GRID ndʒ:GRID sn:LOAN
# codas — the COMPLETE stem-final set (spec §12.D). Singletons: §2.5 [butskhrikidze2002 p.99]
# "the stem can end in any of the 27 consonants (i.e. except /h/)"; §2.8 [p.87] /h/ "never
# occurs in consonant sequences". Clusters: §2.5 Appendix 3 [butskhrikidze2002 pp.207–209]
# — harmonic, obstruent+sonorant, sonorant+obstruent (loans, with her source tags), the
# obstruent set "found only in loans" (st' št' zd xt' šk' xš γd), CCC (i)–(iii), CCCC, the
# CCCCC `nǰgvl`. `rp` is kept (p.208's *šarp-i* over p.207's never-attested set — the
# digest takes the more specific statement). The "attested in neither position" set
# (zb xp χ'p' žb rž lž lš lj) is excluded.
codas    = pʰ pʼ b tʰ tʼ d kʰ kʼ ɡ qʼ ts tsʼ dz tʃʰ tʃʼ dʒ m n v s z ʃ ʒ x ɣ l r bɣ dɣ zɣ ʒɣ pʰx sx ʃx tsʼqʼ tʃʼqʼ zv zr zl pʰr tʰr sl ʃl ʒr ʃn zn xl xr ɣl ɣr nd ndz ndʒ nɡ nkʼ ntʃʰ rɡ rd rdʒ rtʃʰ rkʼ rpʼ rdz rpʰ rb lkʰ lx vz vtʰ stʼ ʃtʼ zd xtʼ ʃkʼ xʃ ɣd pʰxv tsxl tsxv tʼqʼl sxl ntʃʰx rtsx rtʼqʼ vʃv rpʰl rpʼl rbl rxv rɣv rtsv rtʼl rdzl lkʰv ntsʼl rtʰkʰl rtsxl rtsxv rtsʼqʼv ntʃʰxl ndʒɡvl
codas-tier = bɣ:APP3 dɣ:APP3 zɣ:APP3 ʒɣ:APP3 pʰx:APP3 sx:APP3 ʃx:APP3 tsʼqʼ:APP3 tʃʼqʼ:APP3 zv:APP3 zr:APP3 zl:APP3 pʰr:APP3 tʰr:APP3 sl:APP3 ʃl:APP3 ʒr:APP3 ʃn:APP3 zn:APP3 xl:APP3 xr:APP3 ɣl:APP3 ɣr:APP3 nd:APP3 ndz:APP3 ndʒ:APP3 nɡ:APP3 nkʼ:APP3 ntʃʰ:APP3 rɡ:APP3 rd:APP3 rdʒ:APP3 rtʃʰ:APP3 rkʼ:APP3 rpʼ:APP3 rdz:APP3 rpʰ:APP3 rb:APP3 lkʰ:APP3 lx:APP3 vz:APP3 vtʰ:APP3 stʼ:APP3 ʃtʼ:APP3 zd:APP3 xtʼ:APP3 ʃkʼ:APP3 xʃ:APP3 ɣd:APP3 pʰxv:APP3 tsxl:APP3 tsxv:APP3 tʼqʼl:APP3 sxl:APP3 ntʃʰx:APP3 rtsx:APP3 rtʼqʼ:APP3 vʃv:APP3 rpʰl:APP3 rpʼl:APP3 rbl:APP3 rxv:APP3 rɣv:APP3 rtsv:APP3 rtʼl:APP3 rdzl:APP3 lkʰv:APP3 ntsʼl:APP3 rtʰkʰl:APP3 rtsxl:APP3 rtsxv:APP3 rtsʼqʼv:APP3 ntʃʰxl:APP3 ndʒɡvl:APP3
#
# bans (I-14). Only the restrictions §2.6 states categorically AND the §3.7 loan data do not
# contradict are written; a ban marks its span whatever the whitelists say, so each one is
# checked against the attested rows (Mode C, I-25) below.
# §2.10 [butskhrikidze2002 p.101 n.18] "There are no geminates in Georgian" — repeated
# segments (I-2), one line per consonant (a ban has no captures). Repaired by [repair].
bans = pʰ pʰ
bans = pʼ pʼ
bans = b b
bans = tʰ tʰ
bans = tʼ tʼ
bans = d d
bans = kʰ kʰ
bans = kʼ kʼ
bans = ɡ ɡ
bans = qʼ qʼ
bans = ts ts
bans = tsʼ tsʼ
bans = dz dz
bans = tʃʰ tʃʰ
bans = tʃʼ tʃʼ
bans = dʒ dʒ
bans = m m
bans = n n
bans = v v
bans = s s
bans = z z
bans = ʃ ʃ
bans = ʒ ʒ
bans = x x
bans = ɣ ɣ
bans = h h
bans = l l
bans = r r
# §2.6 [butskhrikidze2002 p.102] "Obstruents with identical place of articulation never
# combine": the labial obstruents (class C1 minus /m/ — table (62) and Appendix 2 attest
# `bm`, and the §7 loans *Cambridge, Hamburg* keep /mb/; the digest's own *mb example is
# contradicted by its data). /v/ is in her C1 (*pv).
bans = {pʰ pʼ b v} {pʰ pʼ b v}
# The dorsal class (C4) is NOT banned pairwise: *background* -> /bɛkʼɡraundi/ (§3.7) keeps
# /kʼɡ/. The coronal class (C2) is not banned pairwise either: her own lists attest st' št'
# zd cd ǰd (§2.5, §2.6); only the ORDERING is categorical —
# §2.6 [butskhrikidze2002 p.102] "A posterior coronal may precede an anterior coronal, but
# never follow it" (št ǰd cd attested; *tš *dǰ *dc never); [p.86] a coronal stop + affricate
# is barred (*dc *dǰ) and an affricate is never followed by a fricative (*c's *ǰš).
bans = {d tʰ tʼ dz ts tsʼ z s} {ʃ ʒ tʃʰ tʃʼ dʒ}
bans = {d tʰ tʼ} {ts tsʼ dz}
bans = {ts tsʼ dz tʃʰ tʃʼ dʒ} {s z ʃ ʒ}
# §2.7 [crouch2022-diss p.76, from Chitoran 1999]: "no three adjacent sonorants"
# (*mts'rlis* but *mtvralis*, never *mtvrlis). /v/ is not in her sonorant class C3.
bans = {r l m n} {r l m n} {r l m n}

[repair]
# digest §3.6 [gabunia2021 pp.50–51; rayfield2023 pp.21–24; kirvalidze2017 p.291]: "the data
# are unanimous" — *Twitter* -> /tʼvitʼɛri/, *shopping* -> /ʃɔpʼinɡi/, *puzzle* -> /pʼazli/,
# *killer* -> ქილერი, *troll* -> ტროლი; the native rule §2.10 [butskhrikidze2002 p.101 n.18]
# "Loanwords degeminate on entry: /aleɡoria/, /kʼlasi/". Exceptionless; repeated segments
# (I-2), one line per consonant (every consonant but /h/, which never clusters, §2.8 p.87).
pʰ pʰ -> pʰ %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
pʼ pʼ -> pʼ %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
b b -> b       %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
tʰ tʰ -> tʰ %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
tʼ tʼ -> tʼ %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
d d -> d       %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
kʰ kʰ -> kʰ %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
kʼ kʼ -> kʼ %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
ɡ ɡ -> ɡ    %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
qʼ qʼ -> qʼ %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
ts ts -> ts    %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
tsʼ tsʼ -> tsʼ %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
dz dz -> dz    %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
tʃʰ tʃʰ -> tʃʰ %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
tʃʼ tʃʼ -> tʃʼ %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
dʒ dʒ -> dʒ %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
m m -> m       %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
n n -> n       %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
v v -> v       %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
s s -> s       %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
z z -> z       %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
ʃ ʃ -> ʃ    %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
ʒ ʒ -> ʒ    %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
x x -> x       %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
ɣ ɣ -> ɣ    %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
l l -> l       %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
r r -> r       %attested # digest §3.6 [gabunia2021 pp.50-51]; §2.10 [butskhrikidze2002 p.101 n.18]
# spec §12.E, %fallback. SYNTHETIC: digest §3.0/§3.7 (lines 999–1027) state that NO cluster
# repair is observed in the data ("Georgian does not fix an awkward loan; it declines to
# adopt it", [rayfield2023 p.17]); this directive is ours, for the Irish clusters the §2
# lists do not license (e.g. lenited /hr hl hn/, §2.8 p.87 /h/ never in a sequence).
cluster-fallback = same-length

[stress]
# digest §4.1 [borise2023 p.1, p.32; butskhrikidze2002 p.48, p.152]: fixed initial stress.
procedure = initial
# digest §4.3: stress is weak, "do not write an accent mark" — Result.ipa carries none.
mark = off

[epithets]
# digest §6.1 [wiki-ka-grammar §Declension]: nominative -i on consonant-final roots only;
# vowel-final roots take nothing (§3.5 [gabunia2021 p.51] duty free -> /dutʼi pʰri/).
# Personal names are emitted as the bare stem (§5.3 D4, spec §9 row 7): this affix is
# reached only through the NOUN slot (DESC+NOUN), never applied to a name by default.
NOM_I  = i / C $ _ #
# digest §6.3 [wiki-ka-name §Surnames] line 1310: -eli 'from (place)' (Jaqeli, Tsereteli).
ELI    = ɛ l i / $ _ #
# digest §6.3/§6.4 [wiki-ka-name §Surnames; shosted2006 p.261]: relational -uri, dissimilated
# to -uli after a stem containing a rhotic by the [post-stress] rule below.
URI    = u r i / $ _ #
# digest §6.3 lines 1301-1326 [wiki-ka-name §Surnames]: -shvili 'child', -dze 'son' — "the
# readiest epithet machinery in the language".
SHVILI = ʃ v i l i / $ _ #
DZE    = dz ɛ / $ _ #
# digest §6.2 [wiki-ka-grammar §Pluralisation]: plural -eb- + nominative -i on a C-final root;
# the stem's last /ɑ ɛ/ syncopates before it ([post-stress] below).
EBI    = ɛ b i / C $ _ #

[post-stress]
# Affix follow-ups: these run on the affixed word (stages 3-5 re-run after affixation, spec
# §4.6) and are gated on the `$` join, so an unaffixed word is untouched.
# digest §6.4 [shosted2006 p.261, citing Hewitt 2005:282]: -uri -> -uli when the base contains
# a rhotic (/kʰɑrtʰuli/ vs /tʰbilisuri/). `[-trill]*` = any run of non-rhotics.
r -> l / r [-trill]* $ u _ i #            %attested # digest §6.4 [shosted2006 p.261]
# digest §6.2 [wiki-ka §Morphophonology]: /ɑ ɛ/ in the stem's last syllable is lost before
# -eb- (megobari -> megobrebi), leaving an earlier vowel in place.
{ɑ ɛ} -> 0 / V C* _ C (C) $ ɛ b i #        %attested # digest §6.2 [wiki-ka §Morphophonology]

[respell]
# National 2002 system [ungegn-georgian p.1] (digest §5.1 table), apostrophe = ejective,
# written AFTER the consonant (§5.3 D5, line 1213: "Not an overlay — follow the standard").
# Overlays D1-D3 of digest §5.3 (project conventions, no national-system licence); D4 (bare
# stem) is realised by [epithets], not here. No accents, no length, no stress mark (§5.3).
# D3 first (chunks are opaque, I-19): `y` for /i/ in a non-initial closed syllable
# (spec §9 row 8). "Non-initial" = a syllable precedes (`V C* .`); "closed" = at least one
# consonant before the next boundary or the word end.
i -> "y" / V C* . C* _ C C* .   %design # design: §9.8 · digest §5.3 D3 line 1209 (overlay, no Georgian source)
i -> "y" / V C* . C* _ C C* #   %design # design: §9.8 · digest §5.3 D3 line 1209
# D1: ხ /x/ as `x`, not national `kh` (Xelxyx; ISO 9984 value).
x   -> "x"       %design   # design: digest §5.3 D1 line 1207 [wiki-ka-romanization]
# D2: ჭ /tʃʼ/ as `tch`, not national `ch'` (Tchaeul); no precedent, drops the ejective mark.
tʃʼ -> "tch"     %design   # design: digest §5.3 D2 line 1208
# The national table [ungegn-georgian p.1].
pʰ  -> "p"       %attested # digest §5.1 [ungegn-georgian p.1] ფ
pʼ  -> "p'"      %attested # digest §5.1 [ungegn-georgian p.1] პ
tʰ  -> "t"       %attested # digest §5.1 [ungegn-georgian p.1] თ
tʼ  -> "t'"      %attested # digest §5.1 [ungegn-georgian p.1] ტ
kʰ  -> "k"       %attested # digest §5.1 [ungegn-georgian p.1] ქ
kʼ  -> "k'"      %attested # digest §5.1 [ungegn-georgian p.1] კ
qʼ  -> "q'"      %attested # digest §5.1 [ungegn-georgian p.1] ყ (never `qu`, §5.3)
ɡ   -> "g"       %attested # digest §5.1 [ungegn-georgian p.1] გ
ts  -> "ts"      %attested # digest §5.1 [ungegn-georgian p.1] ც
tsʼ -> "ts'"     %attested # digest §5.1 [ungegn-georgian p.1] წ
dz  -> "dz"      %attested # digest §5.1 [ungegn-georgian p.1] ძ
tʃʰ -> "ch"      %attested # digest §5.1 [ungegn-georgian p.1] ჩ (the unmodified native digraph)
dʒ  -> "j"       %attested # digest §5.1 [ungegn-georgian p.1] ჯ
ʃ   -> "sh"      %attested # digest §5.1 [ungegn-georgian p.1] შ
ʒ   -> "zh"      %attested # digest §5.1 [ungegn-georgian p.1] ჟ
ɣ   -> "gh"      %attested # digest §5.1 [ungegn-georgian p.1] ღ
ɑ   -> "a"       %attested # digest §5.1 [ungegn-georgian p.1] ა
ɛ   -> "e"       %attested # digest §5.1 [ungegn-georgian p.1] ე
ɔ   -> "o"       %attested # digest §5.1 [ungegn-georgian p.1] ო
i   -> "i"       %attested # digest §5.1 [ungegn-georgian p.1] ი
u   -> "u"       %attested # digest §5.1 [ungegn-georgian p.1] უ
r   -> "r"       %attested # digest §5.1 [ungegn-georgian p.1] რ
# b d v z l m n s h pass through as themselves [ungegn-georgian p.1].
