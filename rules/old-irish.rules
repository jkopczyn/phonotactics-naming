# old-irish.rules — the Old Irish target strand (spec docs/specs/2026-08-27-old-irish-design.md;
# digest sources/irish/digest.md §10). Task 8: [meta] [inventory] [classes] and a temporary
# [syllable]. Task 9: [substitute]. Task 10: [syllable] [repair] [stress] [post-stress].
# Task 11: [respell]. Task 13: [mutations]. Task 14: [inflect]. Task 15: the templates section.
# Every rule line cites its digest section, a bibkey, or a design decision (plan R32).

[meta]
name = Old Irish
strand = old-irish
grammar = graphemes
digest = sources/irish/digest.md §10
lexicon = rules/old-irish-lexicon.tsv
orthography = rules/old-irish-orthography.tsv
punctum = on
# spec §11: an EXPLICIT declared mapping. `-` = no partner. Read by spelled.py's quality pass.
quality-pairs = pˠ:pʲ bˠ:bʲ t̪ˠ:tʲ d̪ˠ:dʲ k:c ɡ:ɟ fˠ:fʲ sˠ:ʃ x:ç ɣ:ɣʲ β:βʲ β̃:β̃ʲ ð:ðʲ θ:θʲ mˠ:mʲ n̪ˠ:nʲ ŋ:ɲ l̪ˠ:lʲ ɾˠ:ɾʲ h:h w:- vˠ:vʲ

[inventory]
# digest §10.1 chart [wiki-old-irish §Consonants]. Quality is NOT reversed (spec §4, O-3).
bˠ bʲ t̪ˠ tʲ d̪ˠ dʲ k c ɡ ɟ
# The lenited series (O-1). /xʲ/ IS ç; /ɣʲ/ is its own row (R26).
β βʲ β̃ β̃ʲ ð ðʲ θ θʲ x ç ɣ ɣʲ
# /s f h/ are inventory members (O-5, spec §11 (iii)); what CREATES them is restricted, not
# what may appear.
fˠ fʲ sˠ ʃ h
# One sonorant series (O-2): fortis is a doubled GRAPHEME (Task 7), not a segment.
mˠ mʲ n̪ˠ nʲ ŋ ɲ l̪ˠ lʲ ɾˠ ɾʲ
# 5 short + 5 long [pokorny1914-oldirish-grammar p.6 §4] via digest §10.1, plus the
# post-stress reduction vowel of the §10.2 grid.
i e a o u iː eː aː oː uː ə
# /p/ is "relatively rare… a recent import" (digest §10.1). /w/ is NOT an Old Irish phoneme
# (S6) — the filter rewrites any survivor, so it is admitted only marginally, with its
# slender partner. /ə/ is a reduction and must never be chosen by the inventory fallback.
# Short /æ/ comes from u-infection of stressed /a/, "rampant in names in the prefix air-"
# (digest §10.1) — name-relevant, already a features.tsv row, marginal (S5).
# /hʲ/ "may have been the same sound as /h/ or /xʲ/" (digest §10.1) would sit here too, but
# features.tsv has no hʲ row (Task 1 added only the lenited series), so it is not declared.
marginal: pˠ pʲ w vʲ ə æ

[classes]
# spec §12.J / I-41, extended with the Old Irish lenited series (O-3). The modern-only
# members `vˠ` and `j` (Connacht [vˠ] for /w/; slender ⟨dh gh⟩ = /j/) are kept from the
# irish.rules copy: [substitute] matches them BY CLASS + spelling before rewriting them
# (Task 9; without them `[BROAD orth="bh"]` misses *dubh* /d̪ˠʊvˠ/ and `[SLEN orth="dh"]`
# never fires). `vˠ:vʲ` in quality-pairs exists only so the class test's pairing holds.
BROAD = pˠ bˠ t̪ˠ d̪ˠ fˠ sˠ w vˠ mˠ n̪ˠ l̪ˠ ɾˠ k ɡ x ɣ ŋ β β̃ ð θ
SLEN  = pʲ bʲ tʲ dʲ fʲ ʃ vʲ mʲ nʲ lʲ ɾʲ c ɟ ç j ɲ ɣʲ βʲ β̃ʲ ðʲ θʲ
# digest §2.4: the epenthesis environment is after l n r m (O-15).
SONORANT = mˠ mʲ n̪ˠ nʲ ŋ ɲ l̪ˠ lʲ ɾˠ ɾʲ
# UNMARKED is declared for parity with the other rule files and is NOT used here: this file
# has no [normalize] section, which is UNMARKED's only consumer (S17).
UNMARKED = p b t d f v s m n l r

[substitute]
# The retro-filter (spec §4, §11; plan Task 9). Spelling-driven reversals read the modern
# orthographic tag of each segment (`@orth`, `orth=` — O-6); sound-driven ones apply to every
# word, tagged or not (O-7). The strand takes the CITATION form, so no modern lenition or
# eclipsis is reversed here (spec §11). Deliberately NOT reversed (spec §4): quality, vowel
# length, cluster shape. No rule deletes a final vowel (log finding 4: *cara ~ carae*); the
# ending marker of spec §11 is Task 11's. Rules run in file order and a rewritten segment
# KEEPS its orth tag (word.replaced), which is why the ⟨th⟩ block below is ordered as it is.
# Tags: %attested where a lexicon pair instantiates the rule (spec §4, R17), else %design.
#
# (a) Lenition digraphs -> the lenited series (digest §10.1 chart; §10.2 point 1: "written
#     ph th ch when lenited", point 2: ⟨b d g⟩ non-initially = /v ð ɣ/). Each pair keeps the
#     modern quality (R11): the broad and slender branches are matched by class + spelling.
[BROAD orth="bh"] -> β                  %attested # digest §10.1; lexicon dubh ~ dub, sliabh ~ slíab
[SLEN  orth="bh"] -> βʲ                 %attested # digest §10.1; lexicon bhí (modern /vʲ/) ~ bí
# ⟨mh⟩ -> /β̃/ is a good DEFAULT, not a law (S16): *naomh ~ noíb* and *claíomh ~ claideb* are
# attested rows where modern ⟨mh⟩ descends from Old Irish ⟨b⟩ /β/; the lexicon wins there.
[BROAD orth="mh"] -> β̃                  %attested # digest §10.1; lexicon lámh ~ lám, Domhnall ~ Domnall
[SLEN  orth="mh"] -> β̃ʲ                 %attested # digest §10.1; lexicon Niamh ~ Niam
[BROAD orth="dh"] -> ð                  %attested # digest §10.2 point 2; lexicon adharc ~ adarc
# Modern slender ⟨dh gh⟩ is the glide /j/ (in SLEN, per the I-41 copy above).
[SLEN  orth="dh"] -> ðʲ                 %design   # digest §10.2 point 2 (slender ⟨dh⟩ = /ðʲ/, §10.1 chart)
[BROAD orth="gh"] -> ɣ                  %attested # digest §10.2 point 2; lexicon Lughaidh ~ Lugaid
[SLEN  orth="gh"] -> ɣʲ                 %attested # digest §10.2 point 2; lexicon Lughaidh ~ Lugaid (final ⟨-aidh⟩)
[BROAD orth="ch"] -> x                  %attested # digest §10.2 point 1; lexicon cloch ~ cloch (identity: fixes /x/)
[SLEN  orth="ch"] -> ç                  %attested # digest §10.2 point 1; lexicon cheann ~ cenn (identity: fixes /ç/ = /xʲ/, O-1)
# ⟨th⟩: modern /h/ carries NO quality mark, so `[BROAD orth="th"]`/`[SLEN orth="th"]` can
# never match it. The tag fixes the segment as /θ/ (identity in spelling: *cath ~ cath*);
# the quality then follows the modern caol-le-caol convention exactly as irish.rules
# [normalize] gives it to an unmarked consonant (following vowel, else preceding vowel at
# the word edge). Only ⟨th⟩ yields /θ/ here, so the quality rules need no tag.
@orth("th") -> θ                        %attested # digest §10.2 point 1 (⟨th⟩ = /θ/); lexicon cath ~ cath, bláth ~ bláth
θ -> θʲ / _ [V +front]                  %design   # digest §10.2 point 5 (quality from the glide vowel); irish.rules [normalize] (a)
θ -> θʲ / [V +front] _ #                %design   # digest §10.2 point 5; irish.rules [normalize] (b)
# ⟨ph⟩ and ⟨sh⟩ occur in NONE of the 270 attested modern keys (log finding 3): these lines
# are %design and untested by the regression. Their silence is not coverage.
[BROAD orth="ph"] -> fˠ                 %design   # digest §10.2 point 1 (⟨ph⟩ = /f/); identity, fixes the segment; no attested pair
[SLEN  orth="ph"] -> fʲ                 %design   # digest §10.2 point 1; identity; no attested pair
# ⟨sh⟩ is /h/ or [ç] today; lenited s is /h/ in Old Irish whatever the quality (O-5), and
# /h/ is in no quality class, so one untyped line covers both modern values.
@orth("sh") -> h                        %design   # digest §10.1 (/h/ the lenition product of s, spec §11 (iii)); no attested pair
#
# (b) Modern ⟨ao⟩ -> ⟨áe⟩ (spec §8 row O1, O-13): TWO segments, the O-28 value of ⟨aí⟩/⟨áe⟩
#     (R13: a single /aː/ respells as ⟨á⟩ and makes ⟨áe⟩ unwritable). ⟨óe⟩ is lexicon-only.
@orth("ao") -> a i                      %design   # digest §10.1 diphthongs [pokorny1914-oldirish-grammar p.6 §4]; §10.8 conflict 5 (⟨aí⟩ ≠ ⟨á⟩+glide)
#
# (c) ⟨ia ua⟩ -> ⟨ía úa⟩: the FIRST element only (R12, positional tags O-6). Old Irish /ia ua/
#     are the O-28 values; the modern second element is the reduction vowel.
@orth("ia:1") -> i                      %attested # digest §10.1 diphthongs; lexicon iasc ~ íasc, grian ~ grían, Niall ~ Níall
@orth("ia:2") -> a                      %attested # digest §10.1 diphthongs; lexicon iasc ~ íasc (33 pairs, plan Task 9)
@orth("ua:1") -> u                      %attested # digest §10.1 diphthongs; lexicon tuath ~ túath, cluas ~ clúas
@orth("ua:2") -> a                      %attested # digest §10.1 diphthongs; lexicon tuath ~ túath
#
# (d) Quality digraphs (the largest class, 50 attested pairs — log finding 2). Modern caol le
#     caol brackets the vowel on both sides; Old Irish marks quality by the FOLLOWING glide
#     vowel only (digest §10.2 point 5). The vowel letter that carries the sound survives, at
#     its modern length (spec §4: length is not reversed — R11).
[V +long orth="ea"] -> eː               %attested # digest §10.2 point 5; lexicon beann ~ benn, ceann ~ cenn
[V -long orth="ea"] -> e                %attested # digest §10.2 point 5; lexicon fear ~ fer, bean ~ ben, dearg ~ derg
[V +long orth="io"] -> iː               %design   # digest §10.2 point 5
[V -long orth="io"] -> i                %attested # digest §10.2 point 5; lexicon Fionn ~ Finn
[V +long orth="ai"] -> aː               %design   # digest §10.2 point 5 (R10: `ai` is a real aligner unit)
[V -long orth="ai"] -> a                %attested # digest §10.2 point 5; lexicon athair ~ athair (unstressed ⟨ai⟩ = /ə/ -> a)
[V +long orth="oi"] -> oː               %design   # digest §10.2 point 5
[V -long orth="oi"] -> o                %attested # digest §10.2 point 5; lexicon cloch ~ cloch (gen. cloiche)
[V +long orth="ui"] -> uː               %design   # digest §10.2 point 5
[V -long orth="ui"] -> u                %design   # digest §10.2 point 5
#
# (e) The lax short vowels collapse onto digest §10.1's five short vowels (sound-driven).
#     No `ea -> ɑ` / `a -> ɑ` (S3): irish.rules [normalize] folds ɑ -> a first.
ɪ -> i                                  %attested # digest §10.1 (5 short vowels) [pokorny1914-oldirish-grammar p.6 §4]; lexicon Fionn ~ Finn
ʊ -> u                                  %attested # digest §10.1; lexicon dubh ~ dub
ɛ -> e                                  %design   # digest §10.1
ɔ -> o                                  %attested # digest §10.1; lexicon gorm ~ gorm, cloch ~ cloch
#
# (f) The epenthetic schwa (spec §8 row O5; digest §2.4). By spelling first: the aligner tags
#     it as the SECOND segment of a single sonorant letter (*gorm* -> g o r:1 r:2 m), which
#     fires only where the spelling shows no vowel. Then by sound, for untagged words (O-15).
@orth("r:2") -> 0                       %attested # digest §2.4; lexicon gorm ~ gorm, dearg ~ derg
@orth("l:2") -> 0                       %attested # digest §2.4; lexicon Colmán ~ Colmán
@orth("n:2") -> 0                       %design   # digest §2.4
@orth("m:2") -> 0                       %design   # digest §2.4
ə -> 0 / SONORANT _ C                   %design   # digest §2.4 (after a sonorant, before a consonant — O-15)
#
# (g) Survivors of the digraph rules: /w/ is not an Old Irish phoneme (S6), nor /v/.
w  -> β                                 %design   # digest §10.1 chart (no /w/; lenited b = /v/~/β/)
vˠ -> β                                 %design   # digest §10.1 chart
vʲ -> βʲ                                %design   # digest §10.1 chart

[syllable]
# spec §4: template `any`, sonority off — "Old Irish tolerates the modern cluster set"
# (digest §10). No onset/coda whitelist exists for Old Irish in the held sources.
template = any
onsets   = any
codas    = any
sonority = off
domain   = word
# spec §12.B: a diphthong is two segments and ONE nucleus. The eight are Pokorny's
# [pokorny1914-oldirish-grammar p.6 §4]; the VALUES are `wiki-old-irish` §Vowels' (O-28/R19):
# ai oi ui au eu iu ia ua. Draft 1's `aːi`/`iə` contradicted digest §10.8 conflict 5, which
# quotes Pokorny writing ⟨aí⟩ PRECISELY to distinguish it from long ⟨á⟩ plus a palatal glide.
# CONFLICT: digest §10.6's *Goídelc* [ˈɡoːi̯ðʲelɡ] infobox transcription implies ⟨oí⟩ = /oːi̯/;
# recorded, not generalized from.
# `əi əu` are carried so the filter can pass a modern diphthong through (*Tadhg* /t̪ˠəiɡ/).
nuclei = ai oi ui au eu iu ia ua əi əu

[repair]
# spec §4: "none beyond degemination". O-20 / §12.E: an unattested cluster is KEPT and
# flagged UNATTESTED_CLUSTER, never rewritten — this strand has no whitelist to fall back on.
cluster-fallback = keep
# Degemination over repeated segments (I-2), OBSTRUENTS ONLY: digest §10.2 conv. 3 makes
# ⟨ll nn rr mm⟩ the fortis spelling (O-2), so degeminating a sonorant would erase the
# contrast the orthography carries. One line per [-sonorant] inventory member, the marginal
# /p/ pair included; /vʲ/ is a filter-only transient ([substitute] (g) rewrites it before
# this stage) and gets no line.
bˠ bˠ -> bˠ                             %design   # digest §10.2 conv. 3 (doubling is fortis for sonorants only)
bʲ bʲ -> bʲ                             %design   # digest §10.2 conv. 3
t̪ˠ t̪ˠ -> t̪ˠ                             %design   # digest §10.2 conv. 3
tʲ tʲ -> tʲ                             %design   # digest §10.2 conv. 3
d̪ˠ d̪ˠ -> d̪ˠ                             %design   # digest §10.2 conv. 3
dʲ dʲ -> dʲ                             %design   # digest §10.2 conv. 3
k k -> k                                %design   # digest §10.2 conv. 3
c c -> c                                %design   # digest §10.2 conv. 3
ɡ ɡ -> ɡ                                %design   # digest §10.2 conv. 3
ɟ ɟ -> ɟ                                %design   # digest §10.2 conv. 3
pˠ pˠ -> pˠ                             %design   # digest §10.2 conv. 3; /p/ marginal (digest §10.1)
pʲ pʲ -> pʲ                             %design   # digest §10.2 conv. 3; /p/ marginal (digest §10.1)
β β -> β                                %design   # digest §10.2 conv. 3
βʲ βʲ -> βʲ                             %design   # digest §10.2 conv. 3
β̃ β̃ -> β̃                                %design   # digest §10.2 conv. 3 (⟨mm⟩ is /m/, never /β̃β̃/)
β̃ʲ β̃ʲ -> β̃ʲ                              %design   # digest §10.2 conv. 3
ð ð -> ð                                %design   # digest §10.2 conv. 3
ðʲ ðʲ -> ðʲ                             %design   # digest §10.2 conv. 3
θ θ -> θ                                %design   # digest §10.2 conv. 3
θʲ θʲ -> θʲ                             %design   # digest §10.2 conv. 3
x x -> x                                %design   # digest §10.2 conv. 3
ç ç -> ç                                %design   # digest §10.2 conv. 3
ɣ ɣ -> ɣ                                %design   # digest §10.2 conv. 3
ɣʲ ɣʲ -> ɣʲ                             %design   # digest §10.2 conv. 3
fˠ fˠ -> fˠ                             %design   # digest §10.2 conv. 3
fʲ fʲ -> fʲ                             %design   # digest §10.2 conv. 3
sˠ sˠ -> sˠ                             %design   # digest §10.2 conv. 3
ʃ ʃ -> ʃ                                %design   # digest §10.2 conv. 3
h h -> h                                %design   # digest §10.2 conv. 3

[stress]
# digest §10.3: "Stress is generally on the first syllable" [wiki-old-irish §Stress]; for
# names, "including in nominal compounds" [utaustin-oldirish-lesson1 §1.2].
procedure = initial
mark = on

[post-stress]
# spec §4: "unstressed vowels are not reduced (unlike modern Irish)" — deliberately EMPTY.
# digest §10.2's unstressed-vowel grid is a SPELLING matter and lives in the grapheme table
# (Task 7) and [respell] (Task 11), not here.

[respell]
# Editorial Old Irish orthography (spec §6, §11; digest §10.2 conventions 1-6; plan Task 11).
# This is the ONLY producer of a spelled word on the RETRO path: Task 12 hands the string to
# `SpelledWord.from_spelling`, so every character written here must be a grapheme token of
# rules/old-irish-orthography.tsv (R27; a property test asserts it). Chunks are opaque and
# contexts read the ORIGINAL segment stream (I-19, spec §12.C), which is why the order below
# is load-bearing: guards before the doubling table, diphthongs before single vowels, the
# final ending marker before the schwa grid. Quality is not reversed (O-3): a slender
# consonant is written with the same letter as its broad partner and marked only by the
# §36 glide ⟨i⟩ (conv. 5).
#
# (1) Stops after a nasal or liquid keep their voice and are written SINGLE (digest §10.2
#     conv. 4: "stops after ⟨l n r m⟩ are genuinely ambiguous" — *derc* /dʲerk/ ~ /dʲerɡ/,
#     *imb* /imʲbʲ/, *bind*, *cerd*, *long*, *delg*; §10.4: nasalized ⟨mb nd ng⟩). These
#     must precede table (6), which would otherwise write *mp* or *derc* for /dʲerɡ/.
bˠ -> "b" / {mˠ mʲ} _                   %design   # digest §10.4 (⟨mb⟩ /m/); §10.2 conv. 4 (*imb* /imʲbʲ/)
bʲ -> "b" / {mˠ mʲ} _                   %design   # digest §10.4; §10.2 conv. 4 (*imb*)
d̪ˠ -> "d" / {n̪ˠ nʲ ɾˠ ɾʲ} _             %design   # digest §10.4 (⟨nd⟩); §10.2 conv. 4 (*bind*, *cerd*)
dʲ -> "d" / {n̪ˠ nʲ ɾˠ ɾʲ} _             %design   # digest §10.4 (⟨nd⟩); §10.2 conv. 4 (*bind*, *cerd*)
ɡ -> "g" / {ŋ ɲ l̪ˠ lʲ ɾˠ ɾʲ} _          %attested # digest §10.4 (⟨ng⟩); §10.2 conv. 4 (*long*, *delg*); lexicon dearg ~ derg
ɟ -> "g" / {ŋ ɲ l̪ˠ lʲ ɾˠ ɾʲ} _          %design   # digest §10.4 (⟨ng⟩); §10.2 conv. 4 (*delg* /dʲelɡ/)
k -> "c" / SONORANT _                   %attested # digest §10.2 conv. 4 (*derc*, *daltae* ~ *celtae*: no doubling after l n r m); lexicon adharc ~ adarc
c -> "c" / SONORANT _                   %design   # digest §10.2 conv. 4
t̪ˠ -> "t" / SONORANT _                  %design   # digest §10.2 conv. 4 (*daltae* /daLte/)
tʲ -> "t" / SONORANT _                  %design   # digest §10.2 conv. 4
pˠ -> "p" / SONORANT _                  %design   # digest §10.2 conv. 4; /p/ marginal (digest §10.1)
pʲ -> "p" / SONORANT _                  %design   # digest §10.2 conv. 4; /p/ marginal (digest §10.1)
#
# (2) Unwritten lenition (digest §10.2 conv. 1): "b, d, g, m ... may represent the aspirated
#     or the unaspirated sounds" [pokorny1914-oldirish-grammar p.7 §8]. THERE IS NO ⟨bh dh gh
#     mh⟩ IN OLD IRISH — the single biggest visual difference from a modern name and the
#     lexicon log's largest reversal class.
β -> "b"                                %attested # digest §10.2 conv. 1 [pokorny1914-oldirish-grammar p.7 §8]; lexicon dubh ~ dub, sliabh ~ slíab
βʲ -> "b"                               %attested # digest §10.2 conv. 1; lexicon sliabh ~ slíab (gen. sléibe)
ð -> "d"                                %attested # digest §10.2 conv. 1; lexicon adharc ~ adarc
ðʲ -> "d"                               %attested # digest §10.2 conv. 1; lexicon Lughaidh ~ Lugaid (final ⟨-aid⟩)
ɣ -> "g"                                %attested # digest §10.2 conv. 1; lexicon Lughaidh ~ Lugaid
ɣʲ -> "g"                               %attested # digest §10.2 conv. 1; lexicon Lughaidh ~ Lugaid (gen. Luigdech)
β̃ -> "m"                                %attested # digest §10.2 conv. 1; lexicon lámh ~ lám
β̃ʲ -> "m"                               %attested # digest §10.2 conv. 1; lexicon Niamh ~ ném
#
# (3) Written lenition: "only in the case of c, p, t is aspiration regularly expressed in
#     writing" (conv. 1) — ⟨ch th ph⟩; "in later Old Irish, initial f s come to be written
#     ḟ ṡ". ⟨ph⟩ and ⟨ṡ⟩ only where the SOURCE spelling was ⟨ph⟩ / ⟨sh⟩ (the orth tag
#     survives [substitute]'s rewrite); an /f/ or /h/ of any other origin is ⟨f⟩ / ⟨h⟩.
x -> "ch"                               %attested # digest §10.2 conv. 1; lexicon cloch ~ cloch
ç -> "ch"                               %design   # digest §10.2 conv. 1 (⟨ch⟩ = /x/; /xʲ/ IS ç, O-1)
θ -> "th"                               %attested # digest §10.2 conv. 1; lexicon bláth ~ bláth, cath ~ cath
θʲ -> "th"                              %design   # digest §10.2 conv. 1
@orth("ph") -> "ph"                     %design   # digest §10.2 conv. 1 (⟨ph⟩ = /f/); no attested pair (log finding 3)
fˠ -> "f"                               %attested # digest §10.2 master table (⟨f⟩ = /f/); lexicon Fionn ~ Finn
fʲ -> "f"                               %attested # digest §10.2 master table; lexicon fear ~ fer
@orth("sh") -> "ṡ"                      %design   # digest §10.2 conv. 1 (later Old Irish ⟨ṡ⟩ = /h/); punctum = off renders ⟨s⟩ (O-14)
h -> "h"                                %design   # digest §10.2 conv. 6 (⟨h⟩ = /h/ where a sound is written at all)
#
# (4) Diphthongs, before the single-vowel rules (I-19: each becomes ONE opaque chunk, so a
#     claimed diphthong can never be re-matched as ⟨á⟩ + glide — digest §10.8 conflict 5).
#     Values are the O-28 set (wiki-old-irish §Vowels); ⟨áe⟩ is the filter's default for
#     modern ⟨ao⟩ (spec §8 row O1, O-13; the lexicon also writes ⟨aí⟩ and ⟨óe⟩).
a i -> "áe"                             %design   # digest §10.1 diphthongs [pokorny1914-oldirish-grammar p.6 §4]; design: spec §8 row O1 (⟨ao⟩ -> ⟨áe⟩, O-13)
o i -> "oí"                             %design   # digest §10.1 diphthongs; O-28
u i -> "uí"                             %design   # digest §10.1 diphthongs; O-28
a u -> "áu"                             %design   # digest §10.1 diphthongs; O-28
e u -> "éu"                             %design   # digest §10.1 diphthongs; O-28 (lexicon éan ~ én, gen. éuin)
i u -> "íu"                             %design   # digest §10.1 diphthongs; O-28
i a -> "ía"                             %attested # digest §10.1 diphthongs; lexicon iasc ~ íasc, Niall ~ Níall
u a -> "úa"                             %attested # digest §10.1 diphthongs; lexicon tuath ~ túath
ə i -> "aí"                             %design   # digest §10.1 diphthongs (the modern /əi/ pass-through of [syllable] nuclei, O-28); lexicon Tadhg ~ Tadg is the lexicon's own spelling
ə u -> "áu"                             %design   # digest §10.1 diphthongs (the modern /əu/ pass-through, O-28)
#
# (5) Length: the acute (spec §6; digest §10.1).
aː -> "á"                               %attested # digest §10.1 long vowels; lexicon lámh ~ lám, bláth ~ bláth
eː -> "é"                               %attested # digest §10.1 long vowels; lexicon éan ~ én
iː -> "í"                               %design   # digest §10.1 long vowels
oː -> "ó"                               %design   # digest §10.1 long vowels
uː -> "ú"                               %design   # digest §10.1 long vowels
#
# (6) Conv. 2-3 doubling: "⟨c t p⟩ are voiced /ɡ d b/ non-initially unless doubled" —
#     *macc* /mak/ vs *bec* /bʲeɡ/, *bratt* vs *brot*; "geminating a consonant ensures its
#     unmutated sound". So a non-initial voiceless stop is doubled and a non-initial voiced
#     stop is written with the voiceless letter. This restores *mac -> macc* with no lexical
#     list. Initial = `# _`; (1) has already claimed the post-sonorant cases.
k -> "c" / # _                          %attested # digest §10.2 master table; lexicon cloch ~ cloch, cath ~ cath
k -> "cc"                               %attested # digest §10.2 conv. 2-3 (*macc* /mak/); lexicon mac ~ macc
c -> "c" / # _                          %attested # digest §10.2 master table; lexicon ceann ~ cenn
c -> "cc"                               %attested # digest §10.2 conv. 2-3; lexicon mac ~ macc (gen. maicc)
t̪ˠ -> "t" / # _                         %attested # digest §10.2 master table; lexicon tuath ~ túath
t̪ˠ -> "tt"                              %design   # digest §10.2 conv. 2-3 (*bratt* /brat/)
tʲ -> "t" / # _                         %design   # digest §10.2 master table
tʲ -> "tt"                              %design   # digest §10.2 conv. 2-3
pˠ -> "p" / # _                         %design   # digest §10.2 master table; /p/ marginal (digest §10.1)
pˠ -> "pp"                              %design   # digest §10.2 conv. 2-3 (⟨pp⟩ /p/)
pʲ -> "p" / # _                         %design   # digest §10.2 master table; /p/ marginal
pʲ -> "pp"                              %design   # digest §10.2 conv. 2-3
ɡ -> "g" / # _                          %attested # digest §10.2 master table; lexicon gorm ~ gorm
ɡ -> "c"                                %design   # digest §10.2 conv. 2 (*bec* /bʲeɡ/); the lexicon's own rows may keep ⟨g⟩ (Tadhg ~ Tadg)
ɟ -> "g" / # _                          %design   # digest §10.2 master table
ɟ -> "c"                                %design   # digest §10.2 conv. 2
d̪ˠ -> "d" / # _                         %attested # digest §10.2 master table; lexicon dubh ~ dub, dearg ~ derg
d̪ˠ -> "t"                               %design   # digest §10.2 conv. 2 (*brot* /brod/)
dʲ -> "d" / # _                         %design   # digest §10.2 master table
dʲ -> "t"                               %design   # digest §10.2 conv. 2
bˠ -> "b" / # _                         %attested # digest §10.2 master table; lexicon bláth ~ bláth
bˠ -> "p"                               %design   # digest §10.2 conv. 2 (non-initial ⟨p⟩ = /b/)
bʲ -> "b" / # _                         %attested # digest §10.2 master table; lexicon bean ~ ben
bʲ -> "p"                               %design   # digest §10.2 conv. 2
#
# (7) Sonorant geminates: "double letters mean fortis" (conv. 3), ⟨ll nn rr mm⟩ = /L N R m/
#     (O-2: fortis is the doubled TOKEN, not a segment). R16, stated honestly: modern Irish
#     has no geminates and nothing upstream creates one, so these lines fire only on a
#     lexicon-sourced word, never on filter output. *ainm -> ainmm*, *cill -> cell*,
#     *bainne -> bannae*, *Neasa -> Nessa* are NOT derivable and are lexicon-only; what IS
#     delivered is the spelling of a geminate that already exists.
l̪ˠ l̪ˠ -> "ll"                            %attested # digest §10.2 conv. 3 (⟨ll⟩ /L/); lexicon Niall ~ Níall
lʲ lʲ -> "ll"                           %attested # digest §10.2 conv. 3; lexicon cill ~ cell (gen. cille)
n̪ˠ n̪ˠ -> "nn"                            %attested # digest §10.2 conv. 3 (⟨nn⟩ /N/); lexicon Fionn ~ Finn
nʲ nʲ -> "nn"                           %attested # digest §10.2 conv. 3; lexicon ceann ~ cenn (gen. cinn)
ɾˠ ɾˠ -> "rr"                           %design   # digest §10.2 conv. 3 (⟨rr⟩ /R/)
ɾʲ ɾʲ -> "rr"                           %design   # digest §10.2 conv. 3
mˠ mˠ -> "mm"                           %attested # digest §10.2 conv. 3 (⟨mm⟩ /m/); lexicon ainm ~ ainmm
mʲ mʲ -> "mm"                           %attested # digest §10.2 conv. 3; lexicon ainm ~ ainmm
#
# (8) The §36 glide (digest §10.2 conv. 5): "before a palatal consonant at the end of a word
#     or of a syllable (except after í, é, and the diphthongs áe/aí, óe/oí, uí) a glide-vowel
#     i is regularly inserted" — *muir* < *mori [pokorny1914-oldirish-grammar p.14 §36]. The
#     glide precedes the whole final slender cluster (*cairt*). S20: the exception list is
#     Pokorny's — í, é and the i-final diphthongs (already an ⟨i⟩, the set below omits i) —
#     NOT short ⟨e⟩, and not ⟨ía úa⟩ (gen. *Bríain*). §39: no glide before a broad
#     consonant (*fer*) — the SLEN class does that. The reduction vowel /ə/ is excluded: the
#     grid in (10) writes its own ⟨ai⟩. §37's optional intervocalic glide is not written.
#     "Or of a syllable" is written as "before a consonant" (conv. 5 (ii): slender "after a
#     written i, when not followed by a vowel letter"), NOT with `.`: [syllable] has
#     `onsets = any`, so every medial cluster is an onset and a `.` variant could never fire
#     (*Muirchertach* syllabifies mˠu.ɾʲçeɾˠ.t̪ˠax). The two lines are disjoint by
#     construction (a slender consonant is followed by `#`, a consonant, or a vowel), so a
#     final cluster (*ceinn*, *cairt*) gets one glide, not two.
0 -> "i" / {a e o u aː oː uː} _ SLEN #  %attested # digest §10.2 conv. 5 [pokorny1914-oldirish-grammar p.14 §36]; lexicon muir ~ muir, Colmán ~ Colmán (gen. Colmáin)
0 -> "i" / {a e o u aː oː uː} _ SLEN C  %design   # digest §10.2 conv. 5 (ii) [wiki-old-irish §Orthography]; [pokorny1914-oldirish-grammar p.14 §36] ("or of a syllable")
#
# (9) Word-final /ə/ is the UNRESOLVED ENDING MARKER (spec §11): a grapheme token with an
#     empty reconstruction, realized by Task 14's NOM_A / NOM_O by stem class (*-e* for
#     ā-stems, *-a* otherwise). Never a finished output. Before (10), so the grid cannot
#     claim it.
ə -> "ə" / _ #                          %design   # design: spec §11 "unresolved ending marker"; digest §10.2 conv. 5 (the letter has no relation to the etymological vowel)
#
# (10) The post-stress /ə/ grid (digest §10.2 conv. 5 [wiki-old-irish §Vowels]): "the vowel
#      letter has no relation to the etymological vowel" — it is chosen by the quality of
#      the flanking consonants. Last line: a fallback for an unclassed neighbour (/h/, a
#      vowel, the word start), so the marker token can never leak into a medial position.
ə -> "a" / BROAD _ BROAD                %attested # digest §10.2 conv. 5 grid (*dígal* /ˈdʲiːɣəl/) [wiki-old-irish §Vowels]; lexicon Colmán ~ Colmán
ə -> "ai" / BROAD _ SLEN                %attested # digest §10.2 conv. 5 grid (*dígail* /ˈdʲiːɣəlʲ/); lexicon Lughaidh ~ Lugaid
ə -> "e" / SLEN _ BROAD                 %design   # digest §10.2 conv. 5 grid (*dliged* /ˈdʲlʲiɣʲəð/)
ə -> "i" / SLEN _ SLEN                  %design   # digest §10.2 conv. 5 grid (*dligid* /ˈdʲlʲiɣʲəðʲ/)
ə -> "a"                                %fallback # design: digest §10.2 conv. 5 (broad default where no flanking consonant is classed); keeps the ending token out of medial position
#
# (11) Identity (S21): written explicitly rather than left to the stage's pass-through, so
#      the section is complete over the inventory and the R27 property is checkable.
a -> "a"                                %attested # digest §10.1 short vowels; lexicon cath ~ cath
e -> "e"                                %attested # digest §10.1 short vowels; lexicon fear ~ fer
i -> "i"                                %attested # digest §10.1 short vowels; lexicon Fionn ~ Finn
o -> "o"                                %attested # digest §10.1 short vowels; lexicon cloch ~ cloch
u -> "u"                                %attested # digest §10.1 short vowels; lexicon dubh ~ dub
æ -> "a"                                %design   # design: digest §10.1 (u-infected /a/, marginal); no held source gives its letter — ⟨a⟩ keeps the output tokenizable (R27)
sˠ -> "s"                               %attested # digest §10.2 master table; lexicon sliabh ~ slíab
ʃ -> "s"                                %attested # digest §10.2 master table (no slender letter, conv. 5); lexicon sliabh ~ slíab
l̪ˠ -> "l"                               %attested # digest §10.2 master table; lexicon cloch ~ cloch
lʲ -> "l"                               %attested # digest §10.2 master table; lexicon sliabh ~ slíab
n̪ˠ -> "n"                               %attested # digest §10.2 master table; lexicon éan ~ én
nʲ -> "n"                               %attested # digest §10.2 master table; lexicon Niall ~ Níall
ɾˠ -> "r"                               %attested # digest §10.2 master table; lexicon gorm ~ gorm
ɾʲ -> "r"                               %attested # digest §10.2 master table; lexicon muir ~ muir
mˠ -> "m"                               %attested # digest §10.2 master table; lexicon mac ~ macc
mʲ -> "m"                               %attested # digest §10.2 master table; lexicon Niamh ~ ném
ŋ -> "n"                                %design   # digest §10.2 master table (⟨ng⟩ /ŋ/: the ⟨g⟩ is the stop's letter, written by (1))
ɲ -> "n"                                %design   # digest §10.2 master table
# Filter-only transients: [substitute] (g) rewrites /w vʲ/ before this stage; the lines
# exist so that every INVENTORY member has a spelling (S6, R27).
w -> "b"                                %design   # digest §10.1 chart (no /w/; lenited b = /v/~/β/, written ⟨b⟩ by conv. 1)
vʲ -> "b"                               %design   # digest §10.1 chart
#
# (12) No h-prefix (spec §6; digest §10.2 conv. 6: "there is no consistent relationship"
#      between the letter and the sound — *Ériu* ~ *Hériu*). Deliberately absent: nothing
#      here or in [mutations] writes an ⟨h⟩ before a vowel.

[mutations]
# Initial mutations as GRAPHEME-TOKEN rewrites on the spelled word (spec §5, §11; O-10,
# O-27; plan Task 13). Only the WRITTEN half of each mutation lives here; the unwritten half
# is the spelled word's `mutation` metadata, which `apply_oi_mutation` sets and the
# reconstruction reads (digest §10.2 conv. 1; spec §11 (ii)). Every line is anchored `# _`
# (R20: over tokens, `#` = the first token). Two tables only: no h-prefix, no t-prefix
# (spec §5; digest §10.2 conv. 6), and the third Old Irish mutation (aspiration/gemination,
# digest §10.4 ᴴ) is "not indicated at all" in writing, so it has no table.
#
# Pokorny's lenition-blocking rule is NOT implemented here (S9): lenition is blocked before
# ⟨d t⟩ when the preceding word ends in ⟨l n s⟩ (*cen tossach*) and after a homorganic
# consonant (*cach cloine*) [pokorny1914-oldirish-grammar p.9 §19]. It is a cross-word
# condition, so it belongs to the templates section (Task 15), which records the same
# omission; it bites on COMPOUND and CU.
LEN:
# digest §10.4 [wiki-old-irish §Orthography; pokorny1914-oldirish-grammar p.7 §7]: "only in
# the case of c, p, t is aspiration regularly expressed in writing" (conv. 1); "in later
# Old Irish, initial f s come to be written ḟ ṡ".
c -> ch / # _                           %attested # digest §10.4 (/k/ -> /x/ ⟨ch⟩); §10.4 contrast set *tech* ~ *a thech*; lexicon Máel Coluim (gen.) ~ Cú Chulainn (lenited gen.)
t -> th / # _                           %attested # digest §10.4 (/t/ -> /θ/ ⟨th⟩); §10.4 contrast set *tech* ~ *a thech*
p -> ph / # _                           %design   # digest §10.4 (/p/ -> /f/ ⟨ph⟩); /p/ marginal (digest §10.1), no attested pair
s -> ṡ / # _                            %design   # digest §10.4 (/s/ -> /h/ ⟨ṡ sh⟩); §10.2 master table ⟨ṡ sh⟩ = /h/; punctum = off renders ⟨s⟩ (O-14)
f -> ḟ / # _                            %design   # digest §10.4 (/f/ -> ∅ ⟨ḟ fh⟩); R24: ⟨ḟ⟩ is a token with an empty reconstruction, so nothing is deleted
# Deliberately absent — b d g m: lenited but unwritten (digest §10.2 conv. 1 [pokorny1914-
# oldirish-grammar p.7 §8]); `mutation = "LEN"` makes the reconstruction give /β ð ɣ β̃/.
# Deliberately absent — l n r: digest §10.4 "/L N R/ -> /l n r/ (never written)". This
# implementation has ONE sonorant series (O-2: fortis is the doubled token ⟨ll nn rr⟩, not
# a segment), so fortis -> lenis lenition of a single initial letter would be an identity.
# Deliberately absent — s₂ -> /f/ ⟨f ph⟩ (digest §10.4; §10.2 note 1: from *sw, *sɸ): a
# handful of lexical items (S8), lexicon only.
NAS:
# digest §10.4 [pokorny1914-oldirish-grammar p.10 §21]: "It is only in the case of b, d, g
# and of initial vowels that eclipsis is regularly expressed in writing."
b -> mb / # _                           %attested # digest §10.4 (/b/ -> /m/ ⟨mb⟩); §10.4 contrast set *bo* ~ *a m-bo*. O-29 / R25: ⟨mb⟩ is ONE token reconstructing as /m/ (§10.2 master table); §10.4's /a mbo/ is the digest-internal counter-datum, recorded on the token's row
d -> nd / # _                           %attested # digest §10.4 (/d/ -> /N/ ⟨nd⟩); §10.2 master table ⟨d⟩ eclipsed
g -> ng / # _                           %attested # digest §10.4 (/ɡ/ -> /ŋ/ ⟨ng⟩); §10.2 master table ⟨g⟩ eclipsed
0 -> n- / # _ V                         %attested # digest §10.4 (vowel -> /n/+V ⟨n-⟩); §10.4 contrast set *ech* ~ *a n-ech* /a nex/
# Deliberately absent — c t p: nasalization of the voiceless stops is NOT written (spec §11
# (ii); digest §10.4 "/p t k/ -> /b d ɡ/ (unwritten)"); `mutation = "NAS"` makes the
# reconstruction give /ɡ d̪ˠ bˠ/ (§10.4 contrast set *tech* ~ *a tech* /a dʲex/).
# Deliberately absent — s r l n m: digest §10.4 "*s r l n m* unchanged"; §10.2: "r l n s are
# not subject to eclipsis".
# Deliberately absent — f: digest §10.4 gives "/f/ -> /v/ (written ⟨b⟩)"; neither spec §5
# nor §11 lists it and the plan's Task 13 table omits it, so it is left for a later decision
# rather than half-written (⟨b⟩ initial would reconstruct as /b/, not /v/).
