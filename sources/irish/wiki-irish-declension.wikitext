|-
| Vocative || {{lang|ga|a bhádóir}} {{IPA|/ə ˈwaːd̪ˠoːɾʲ/}} || {{lang|ga|a bhádóirí}} {{IPA|/ə ˈwaːd̪ˠoːɾʲiː/}}
|-
| Genitive || {{lang|ga|bádóra}} {{IPA|/ˈbˠaːd̪ˠoːɾˠə/}} || {{lang|ga|bádóirí}} {{IPA|/ˈbˠaːd̪ˠoːɾʲiː/}}
|}
{|class="wikitable"
